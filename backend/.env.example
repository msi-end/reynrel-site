PORT=1111
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-after-first-login
CORS_ORIGIN=http://localhost:5183
# 64 hex chars. Encrypts partner PAN & bank account numbers at rest. BACK IT UP — losing it makes them unreadable.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARTNER_DATA_KEY=
# Set to the number of reverse proxies in front of Node (e.g. 1 behind nginx) so rate limiting sees real client IPs.
TRUST_PROXY=loopback
