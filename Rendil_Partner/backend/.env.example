# ---- Server ----
PORT=5100
NODE_ENV=production
# Comma-separated origins allowed to call the API (only needed if the frontend is served from another origin)
CORS_ORIGIN=
# Number of reverse proxies in front of Node (1 behind nginx) so rate limits see real client IPs
TRUST_PROXY=loopback

# ---- Database ----
# mysql (recommended) or sqlite (single file, zero setup)
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rendil_partner
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=rendil_partner
# Used only when DB_CLIENT=sqlite
SQLITE_FILE=storage/data/rendil_partner.db

# ---- Security ----
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 64 hex chars. Encrypts PAN and bank account numbers. BACK IT UP — without it they cannot be decrypted.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# ---- First admin (created on first start only) ----
ADMIN_EMAIL=admin@reynrel.in
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Rendil Admin
